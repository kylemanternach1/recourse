# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=https://recourse.local
OPENROUTER_APP_NAME=Recourse

# Reasoning / "thinking" effort: low | medium | high | off (default: medium)
# Only applies to OpenRouter requests; non-reasoning models silently ignore it.
OPENROUTER_REASONING=high

# Generic OpenAI-compatible fallback
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
